{
  "private": true,
  "name": "are-you-normal",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "dev:api": "tsx dev/server.ts",
    "dev:web": "vite --config dev/vite.config.ts",
    "deploy": "npm run test:types && npm run lint && npm test && devvit upload",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --build && tsc -p tools/tsconfig.tests.json",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/analytics": "^0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@fontsource-variable/jost": "^5.3.0",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@devvit/test": "^0.15.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "^4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "^3.2.7"
  }
}
