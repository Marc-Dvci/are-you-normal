{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "areyounormaldaily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "realtime": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "scope": "user"
    }
  },
  "scheduler": {
    "tasks": {
      "new-edition": {
        "endpoint": "/internal/scheduler/new-edition",
        "cron": "1 0 * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Post today's edition",
        "description": "Are You Normal? Makes today's post if the daily job has not.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/new-edition"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "areyounormaldaily_dev"
  }
}
